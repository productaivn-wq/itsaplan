{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "BETTER_AUTH_SECRET",
    "API_URL",
    "APP_URL",
    "API_PORT",
    "APP_ENCRYPTION_KEY",
    "ITSAPLAN_RESOLVED_DATABASE_URL",
    "ITSAPLAN_RESOLVED_BETTER_AUTH_SECRET",
    "ITSAPLAN_RESOLVED_APP_ENCRYPTION_KEY",
    "ITSAPLAN_ALLOW_HOST_BRIDGE",
    "NEXT_PUBLIC_ENABLE_HOST_VIBE"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "start": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "cache": false
    },
    "lint": {},
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    }
  }
}
